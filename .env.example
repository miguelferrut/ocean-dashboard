# Copy to .env.local for local development. Never commit real values.

# Public (shipped to the browser). Safe to expose: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Absolute URL used in invite / password-reset email links. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses RLS — used solely for the Auth admin API (invite, disable users).
# Never prefix with NEXT_PUBLIC_. In Vercel mark it "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=<service role key>
